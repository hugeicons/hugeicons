{
  "name": "@hugeicons/mcp-server",
  "version": "0.4.0",
  "description": "MCP server for Hugeicons search and usage documentation",
  "type": "module",
  "bin": {
    "hugeicons-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js build/http.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "npm run build && node --test --test-force-exit test/*.test.mjs",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "hugeicons",
    "mcp",
    "icons",
    "model-context-protocol",
    "icon-search",
    "unicode",
    "glyphs",
    "icon-fonts",
    "claude",
    "ai-tools"
  ],
  "author": "Hugeicons",
  "homepage": "https://hugeicons.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugeicons/hugeicons.git",
    "directory": "tools/mcp-server"
  }
}
