      ],
      "dist/esm/Grid3X3Icon": [
        "./dist/types/Grid3x3Icon.d.ts"
      ],
      "loader": [
        "./dist/types/loader.web.d.ts"
      ],
      "*": [
        "./dist/types/*"
      ]
    }
  },
  "scripts": {
    "build": "rollup -c",
    "build:main": "rollup -c",
    "build:icons": "BUILD_INDIVIDUAL_ICONS=true node --max-old-space-size=8192 node_modules/.bin/rollup -c",
    "clean": "rm -rf dist",
    "publish:prod": "pnpm build && npm publish --access public --no-git-checks",
    "publish:beta": "pnpm build && npm publish --access public --tag beta --no-git-checks"
  },
  "author": "Hugeicons",
